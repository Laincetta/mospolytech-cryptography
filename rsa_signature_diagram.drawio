        <mxCell id="S1hs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Хеш-функция квадратичной свёртки:&#xa;h = 0; для каждого символа c:&#xa;m_i = АЛФАВИТ.find(c) + 1&#xa;h = (h + m_i)² mod N&#xa;(хеш зависит от N)" vertex="1"><mxGeometry x="0" y="389" width="240" height="100" as="geometry" /></mxCell>
