        <mxCell id="T1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size:14px&quot;&gt;encrypt_block(block)&lt;/font&gt;" vertex="1"><mxGeometry x="54" y="20" width="240" height="20" as="geometry" /></mxCell>
