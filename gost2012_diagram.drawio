        <!-- COL 2: Проверка подписи (ЭКЦ ГОСТ 2012) -->
        <mxCell id="T2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size:14px&quot;&gt;Проверка подписи — ГОСТ Р 34.10-2012&lt;/font&gt;" vertex="1"><mxGeometry x="480" y="20" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="V2s" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" value="Начало" vertex="1"><mxGeometry x="480" y="79" width="240" height="40" as="geometry" /></mxCell>
        <mxCell id="V2i" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Ввод: сообщение, подпись (r, s), параметры кривой (a, b, p), G, открытый ключ Y" vertex="1"><mxGeometry x="480" y="159" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="V2q" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="q = find_point_order(G, a, p)&#xa;(порядок точки G на кривой)" vertex="1"><mxGeometry x="480" y="289" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="V2hs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Хеш: Hm = hash_message(текст, p) mod q&#xa;если Hm=0 → Hm=1" vertex="1"><mxGeometry x="480" y="389" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="V2hi" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="h_inv = mod_inverse(Hm, q)&#xa;(= Hm⁻¹ mod q)" vertex="1"><mxGeometry x="480" y="489" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="V2u" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="u1 = (s × h_inv) mod q&#xa;u2 = (−r × h_inv) mod q" vertex="1"><mxGeometry x="480" y="589" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="V2p" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="P = u1×G + u2×Y&#xa;= scalar_mult(u1,G) + scalar_mult(u2,Y)" vertex="1"><mxGeometry x="480" y="689" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="V2o" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Сравнение:&#xa;P.x mod q = r → подпись ВЕРНА&#xa;P.x mod q ≠ r → подпись НЕВЕРНА" vertex="1"><mxGeometry x="480" y="799" width="240" height="90" as="geometry" /></mxCell>
