        <mxCell id="S1p" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Вычислить точку P = k × G&#10;r = X-координата точки P mod q" vertex="1"><mxGeometry x="54" y="739" width="240" height="60" as="geometry" /></mxCell>
