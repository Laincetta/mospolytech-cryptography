        <mxCell id="S1q" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Нахождение порядка подгруппы q:&#10;перебор точек кривой до возврата в начальную точку G" vertex="1"><mxGeometry x="54" y="289" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="S1y" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Открытый ключ: Y = x × G&#10;(скалярное умножение точки G на секретный ключ x)" vertex="1"><mxGeometry x="54" y="399" width="240" height="60" as="geometry" /></mxCell>
