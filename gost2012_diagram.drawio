  <diagram name="ГОСТ 34.10-2012" id="GOST2012_MAIN">
    <mxGraphModel dx="1836" dy="2816" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <!-- COL 1: Создание подписи (ЭКЦ ГОСТ 2012) -->
        <mxCell id="T1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size:14px&quot;&gt;Создание подписи — ГОСТ Р 34.10-2012&lt;/font&gt;" vertex="1"><mxGeometry x="0" y="20" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="S1s" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" value="Начало" vertex="1"><mxGeometry x="0" y="79" width="240" height="40" as="geometry" /></mxCell>
        <mxCell id="S1i" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Ввод: текст, параметры кривой (a, b, p), базовая точка G, секретный ключ x" vertex="1"><mxGeometry x="0" y="159" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="S1q" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Нахождение порядка подгруппы:&#xa;q = find_subgroup_order(G, a, p)&#xa;(перебор точек кривой)" vertex="1"><mxGeometry x="0" y="289" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="S1y" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Открытый ключ:&#xa;Y = [x]G (scalar_mult(x, G, a, p))" vertex="1"><mxGeometry x="0" y="399" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="S1hs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Хеш сообщения (квадратичная свёртка):&#xa;Hm = hash_message(текст, p) mod q&#xa;если Hm=0 → Hm=1" vertex="1"><mxGeometry x="0" y="499" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="S1k" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Ввод случайного k (эфемерный ключ): 1 &lt; k &lt; q" vertex="1"><mxGeometry x="0" y="609" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="S1p" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="P = [k]G = scalar_mult(k, G, a, p)&#xa;r = P.x mod q" vertex="1"><mxGeometry x="0" y="739" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="S1sg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="s = (k × Hm + r × x) mod q&#xa;если r=0 или s=0 → повторить выбор k" vertex="1"><mxGeometry x="0" y="839" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="S1o" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Возврат подписи S = (r, s)&#xa;и открытого ключа Y" vertex="1"><mxGeometry x="0" y="949" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="S1e" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" value="Конец" vertex="1"><mxGeometry x="0" y="1079" width="240" height="40" as="geometry" /></mxCell>
