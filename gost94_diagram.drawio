        <mxCell id="T1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size:14px&quot;&gt;sign_message(text) — ГОСТ Р 34.10-94&lt;/font&gt;" vertex="1"><mxGeometry x="54" y="20" width="240" height="20" as="geometry" /></mxCell>
        <mxCell id="S1s" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.terminator;whiteSpace=wrap;" value="Начало" vertex="1"><mxGeometry x="54" y="79" width="240" height="40" as="geometry" /></mxCell>
        <mxCell id="S1i" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Ввод: текст и простое число p (p &amp;gt; 32)" vertex="1"><mxGeometry x="54" y="159" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="S1q" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Найти простые множители числа (p−1)&#10;Выбрать q — один из простых сомножителей" vertex="1"><mxGeometry x="54" y="289" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="S1a" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Найти основание a (1 &amp;lt; a &amp;lt; p−1)&#10;условие: a^q mod p = 1" vertex="1"><mxGeometry x="54" y="399" width="240" height="70" as="geometry" /></mxCell>
        <mxCell id="S1x" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Ввод: секретный ключ x (1 &amp;lt; x &amp;lt; q)" vertex="1"><mxGeometry x="54" y="509" width="240" height="90" as="geometry" /></mxCell>
        <mxCell id="S1y" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Вычислить открытый ключ: y = a^x mod p" vertex="1"><mxGeometry x="54" y="639" width="240" height="60" as="geometry" /></mxCell>
        <mxCell id="S1hs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Хеш квадратичной свёртки:&#10;Hm = hash(текст, p) mod q&#10;если Hm = 0, то Hm = 1" vertex="1"><mxGeometry x="54" y="739" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="S1k" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Выбрать случайное k (1 ≤ k &amp;lt; q)&#10;r = (a^k mod p) mod q,  r ≠ 0&#10;s = (x × r + k × Hm) mod q,  s ≠ 0&#10;(повторить при r = 0 или s = 0)" vertex="1"><mxGeometry x="54" y="859" width="240" height="80" as="geometry" /></mxCell>
        <mxCell id="S1o" parent="1" style="shape=parallelogram;html=1;strokeWidth=2;perimeter=parallelogramPerimeter;whiteSpace=wrap;rounded=1;arcSize=12;size=0.23;" value="Возврат подписи S = (r, s)&#10;и открытого ключа (p, q, a, y)" vertex="1"><mxGeometry x="54" y="979" width="240" height="90" as="geometry" /></mxCell>
