        <mxCell id="S1hs" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Хеш-функция квадратичной свёртки:&#xa;m = get_hash(replace(текст), p−1)&#xa;h = Σ(h + m_i)² mod p, если m=0 → m=1" vertex="1"><mxGeometry x="0" y="389" width="240" height="90" as="geometry" /></mxCell>
